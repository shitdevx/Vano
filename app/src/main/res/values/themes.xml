<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark window background prevents light flash before Compose draws -->
    <style name="Theme.Vano" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/vano_background</item>
        <item name="android:statusBarColor">@color/vano_background</item>
        <item name="android:navigationBarColor">@color/vano_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>